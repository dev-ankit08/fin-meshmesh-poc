PORT=8787
# Shared secret Fin sends as: Authorization: Bearer <token>  (generate a long random value; never commit it)
FIN_BEARER_TOKEN=
# mock = simulate MeshMesh locally; live = real MCP calls
MESHMESH_MODE=mock
MESHMESH_MCP_URL=https://gateway.meshmesh.io/mcp
# From MeshMesh list_connections (the Salesforce org connection to configure)
MESHMESH_CONNECTION_ID=
AUTO_APPROVE_PLAN=true
POLL_INTERVAL_MS=15000
MAX_RUN_MINUTES=30
# Public HTTPS URL of this bridge (tunnel or hosted)
PUBLIC_BASE_URL=
# After-conversation fallback: reply into the Intercom conversation via REST when Fin's final
# webhook can't be delivered (wait expired / conversation closed). Needs the connector to send conversation_id.
INTERCOM_ACCESS_TOKEN=
INTERCOM_ADMIN_ID=
# comment = customer sees it (default) | note = internal only
INTERCOM_REPLY_TYPE=comment
# fallback (default) | always
INTERCOM_REPLY_MODE=fallback

# Independent read-only Salesforce guard: Salesforce CLI alias of the target org
SF_TARGET_ORG=
SF_GUARD=true
# Duplicate pre-check before MeshMesh; set false only for controlled-failure tests
SF_PRECHECK=true

# v2 generic requests
# What MeshMesh may change through chat (allow/deny lists, watch types for drift detection)
# POLICY_FILE=config/policy.json
# How long a plan shown to the customer can be approved
PLAN_TTL_MINUTES=60
